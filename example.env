# Registered application — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# A user access token and its refresh token (authorization-code or device-code flow).
# Leave blank to run on an app access token (client-credentials) instead.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Chat client (optional) — set a nick to connect IRC. Token needs chat:read + chat:edit.
TWITCH_NICK=Valgorithms
TWITCH_CHANNELS=twitchdev

# The channel you operate on. Look up an id: https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BROADCASTER_ID=29034572
