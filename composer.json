{
    "name": "vzgcoders/twitchphp",
    "description": "An async ReactPHP framework for the Twitch Helix API, EventSub, and chat — built like DiscordPHP.",
    "keywords": ["twitch", "helix", "eventsub", "irc", "chat", "bot", "reactphp", "async", "api-client"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Valithor Obsidion",
            "email": "valithor@valgorithms.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Valgorithms/TwitchPHP/issues",
        "source": "https://github.com/Valgorithms/TwitchPHP"
    },
    "require": {
        "php": "^8.4",
        "twitchphp/http": "dev-main",
        "discord-php-helpers/collection": "dev-main",
        "evenement/evenement": "^3.0",
        "nesbot/carbon": "^3.8 || ^2.72",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "ratchet/pawl": "^0.4.1",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2 || ^2.11",
        "react/socket": "^1.16",
        "symfony/options-resolver": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "monolog/monolog": "^3.0",
        "phpunit/phpunit": "^11.0 || ^10.5",
        "react/async": "^4.3 || ^3.2"
    },
    "suggest": {
        "monolog/monolog": "A PSR-3 logger for the client's debug output",
        "ext-uv": "A faster ReactPHP event loop"
    },
    "autoload": {
        "psr-4": {
            "Twitch\\": "src/Twitch"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Twitch\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
